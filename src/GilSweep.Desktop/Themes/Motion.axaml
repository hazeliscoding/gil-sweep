<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:GilSweep.Desktop.Controls">
  <!--
    Every animation lives here. App leaves this file out when Windows animations are off
    (Settings > Accessibility > Visual effects), so nothing moves for people who asked for that.
  -->

  <Style Selector="c|Spinner.spin">
    <Style.Animations>
      <Animation Duration="0:0:0.7" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Rows and cards arrive with a short rise. -->
  <Style Selector=":is(Control).enter">
    <Style.Animations>
      <Animation Duration="0:0:0.24" Easing="CubicEaseOut" FillMode="Backward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="4" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Loading placeholders shimmer. -->
  <Style Selector="c|Skeleton /template/ Border#PART_Shine">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="-160" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="900" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- A live indicator (an update waiting, a sweep running) blinks gently. -->
  <Style Selector=":is(Control).blink">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="c|GsSwitch /template/ Ellipse#PART_Knob">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
</Styles>
