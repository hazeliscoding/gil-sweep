<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>GilSweep.Core</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!-- The curated item database, recipes and demand signals ship inside the assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="Data\*.json" LogicalName="GilSweep.Data.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GilSweep.Tests" />
    <InternalsVisibleTo Include="GilSweep.Screenshots" />
  </ItemGroup>

</Project>
